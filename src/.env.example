```env
# ARES — Threat Intelligence Correlation & Alert Prioritisation Assistant
# Copy this file to .env if local environment variables are needed.
# NEVER commit the .env file — it is included in .gitignore.

# --------------------------------------------------
# Application
# --------------------------------------------------
APP_PORT=8000
APP_ENV=development

# --------------------------------------------------
# LLM Configuration
# --------------------------------------------------
# ARES uses an external LLM for BLUF report generation.
# Set the provider/API key required by the BLUF generation implementation.
# Do not commit real credentials.

GROQ_API_KEY=
GEMINI_API_KEY=

# --------------------------------------------------
# Demo / Simulation
# --------------------------------------------------
# ARES currently operates on simulated security telemetry.
# No live SIEM, firewall, network sensor, threat-intelligence,
# Slack, PostgreSQL, or IBM watsonx.ai connection is required.

ARES_DEMO_MODE=true

# Add project-specific variables below if required.
```
